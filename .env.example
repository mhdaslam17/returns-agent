# Copy this file to .env and fill in your own values.
# .env is in .gitignore. Never commit real keys.

# LLM: any OpenAI-compatible API. Change provider by changing these 3 lines.
# Default: Groq free tier. Key from console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# Other options (examples):
#   Gemini free tier (only 20 requests/day per model, too few for a full eval):
#       LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-3.6-flash
#   Ollama on your PC (free, no key): LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
#   OpenAI:                           LLM_BASE_URL=https://api.openai.com/v1

# Tracing (LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=returns-agent
